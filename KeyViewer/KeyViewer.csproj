<Project Sdk="Microsoft.NET.Sdk">

  <!--
    跨平台构建（Linux/macOS/Windows 均可，仅需 .NET SDK）。
    直接引用游戏 Managed 目录里的程序集进行编译，不依赖 .NET Framework 参考程序集。
    如游戏安装在别处，用 -p:Managed=... 覆盖下面的默认路径，例如：
      dotnet build -c Release -p:Managed="D:/Steam/.../A Dance of Fire and Ice_Data/Managed"
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>KeyViewer</AssemblyName>
    <RootNamespace>KeyViewer</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- 直接对着游戏运行时程序集编译，避免缺少 net48 参考程序集 -->
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>

    <!-- 游戏 Managed 目录：按需用 -p:Managed=... 覆盖 -->
    <Managed Condition="'$(Managed)' == ''">$(MSBuildProjectDirectory)/../../A Dance of Fire and Ice/A Dance of Fire and Ice_Data/Managed</Managed>
  </PropertyGroup>

  <!-- 引用游戏自带的全部程序集（含 mscorlib / System / Unity* / Assembly-CSharp / UnityFileDialog 等） -->
  <ItemGroup>
    <Reference Include="$(Managed)/*.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(Managed)/UnityModManager/*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- NCalc：运行时由 Mods/KeyViewer/lib/NCalc.dll 提供，编译期仅作引用，不复制输出 -->
  <ItemGroup>
    <PackageReference Include="ncalc" Version="1.3.8">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- RapidGUI 等用到的内嵌图片资源，逻辑名形如 KeyViewer.MiscFiles.images.<name>.png -->
  <ItemGroup>
    <EmbeddedResource Include="MiscFiles/images/*.png" />
  </ItemGroup>

</Project>
